<?xml version="1.0" encoding="utf-8"?>
<!-- Glass sheen + hairline rim over the widget card. The tint underneath is drawn in code from the app's
     theme (primaryContainer at Settings › Widget opacity); RemoteViews can't run the in-app lens shader. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <corners android:radius="28dp" />
    <gradient android:angle="270" android:startColor="#59FFFFFF" android:centerColor="#00FFFFFF" android:endColor="#14FFFFFF" />
    <stroke android:width="1dp" android:color="#80FFFFFF" />
</shape>
